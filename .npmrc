# peer 依赖（@deepseek-ai/*）由 devDependencies 里的 link:../deepseek-harness 本地包满足，
# 不从 registry 自动拉取（@deepseek-ai 的 rc 包在 registry 上陈旧/缺失，拉取会 404）。
auto-install-peers=false

# 固定 pnpm 版本：运行版本必须与 packageManager 字段完全一致（packageManager: pnpm@11.21.0），
# 且 node/pnpm 必须满足 engines 声明（`>=22` / `>=11.21.0`），不匹配即失败。
package-manager-strict=true
engine-strict=true
